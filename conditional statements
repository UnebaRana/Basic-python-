# ATM Cash Withdrawal Limit

balance = 15000

amount = int(input("Enter withdrawal amount: "))

if amount <= 0:
    print("Invalid withdrawal amount")
elif amount <= balance:
    balance = balance - amount
    print("Withdrawal Successful")
    print("Updated Balance:", balance)
else:
    print("Insufficient Funds")
