QUESTION 8:
def analyze_text(user_input):
    vowels = "aeiouAEIOU"
    v_count = 0
    c_count = 0

    for ch in user_input:
        if ch.isalpha():
            if ch in vowels:
                v_count += 1
            else:
                c_count += 1

    return v_count, c_count

v_cnt, c_cnt = analyze_text("Saumya")

print("Vowels =", v_cnt)
print("Consonants =", c_cnt)
OUTPUT:
Vowels = 3
Consonants = 3
