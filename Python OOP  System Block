QUESTION 1:
class Product:
    def __init__(self):
        self.name = "Unknown"
        self.price = 0

# Object 1
laptop = Product()
laptop.name = "Laptop"
laptop.price = 120000

# Object 2
smartphone = Product()
smartphone.name = "Smartphone"
smartphone.price = 50000

print("Product 1:")
print("Name:", laptop.name)
print("Price:", laptop.price)

print("\nProduct 2:")
print("Name:", smartphone.name)
print("Price:", smartphone.price)
OUTPUT:
Product 1:
Name: Laptop
Price: 120000

Product 2:
Name: Smartphone
Price: 50000
